{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Local Control Centre window only. No remote origin (including the engine console) is granted IPC.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-get-overview",
    "allow-check-health",
    "allow-plan-action",
    "allow-run-action",
    "allow-service-status",
    "allow-open-console",
    "allow-mt5-overview",
    "allow-mt5-detect",
    "allow-mt5-save-profile",
    "allow-mt5-select-profile",
    "allow-mt5-delete-profile",
    "allow-mt5-link",
    "allow-engine-status",
    "allow-engine-bootstrap-admin",
    "allow-engine-use-demo-account"
  ]
}
