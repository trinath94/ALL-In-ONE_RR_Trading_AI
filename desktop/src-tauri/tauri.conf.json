{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RR Trading One",
  "version": "0.2.0",
  "identifier": "com.rrtrading.one",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RR Trading One - Control Centre",
        "url": "index.html",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "RR Trading",
    "shortDescription": "RR Trading One",
    "longDescription": "All-in-one Windows control centre for the RR Trading Engine and MetaTrader 5.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "perMachine" }
    }
  }
}
